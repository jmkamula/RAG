#!/usr/bin/env bash
# scripts/git-hooks/pre-commit — regenerate golden images before commit.
#
# Watches the staged diff. When authoring sources change, regenerates
# the affected golden image(s) so the commit lands with matching
# source + golden state.
#
# Per-store rebuild triggers:
#
#   Postgres  (fast, ~5-10s)
#     · db/schema_v*.sql                        (new migration)
#     · deploy/postgres_preamble.sql            (role/db bootstrap)
#     · deploy/baseline_grants.sql              (grants)
#     · db/baseline/schema*.sql                 (someone edited golden directly)
#     · db/baseline/seed_curator_data.sql       (same)
#     → runs `scripts/build_pg_baseline.sh`
#     → git-adds the three regenerated files
#
#   Neo4j     (~2-3 min against live dev host)
#     · load_neo4j.py, load_graph_relationships.py
#     · scripts/seed_27701_requirement_nodes.py
#     · enrichment/relationships/**, enrichment/documents/**
#     · iso_nodes_phase1.json, gdpr_nodes_phase2.json
#     · db/baseline/load_neo4j_baseline.py      (loader change)
#     → runs `scripts/build_neo4j_baseline.sh`
#     → git-adds db/baseline/neo4j_baseline.json
#
#   Chroma    (MANUAL — requires OpenAI $ + private/ PDFs)
#     If source changes touch chroma-affecting files, we WARN but
#     don't auto-rebuild. Run `bash scripts/build_chroma_baseline.sh`
#     manually before a release.
#     · scripts/index_*.py, scripts/reindex_all.py
#     · scripts/build_must_index.py
#     · rag/embedding_config.py
#     · db/baseline/neo4j_baseline.json         (Neo4j source of embeddings)
#
# Enable per-clone with:
#   git config core.hooksPath scripts/git-hooks
#
# Escape hatches:
#   git commit --no-verify              # bypass ALL hooks
#   SKIP_GOLDEN_REBUILD=1 git commit    # bypass ONLY the golden rebuild
#
# On rebuild failure the commit aborts — better to fail loud than
# commit stale goldens.

set -euo pipefail

if [[ "${SKIP_GOLDEN_REBUILD:-0}" -eq 1 ]]; then
    exit 0
fi

REPO="$(git rev-parse --show-toplevel)"

# Files in the CURRENT staged diff (not the working tree — only what's
# actually going into this commit).
staged=$(git diff --cached --name-only --diff-filter=ACMR)

# ── Postgres ──────────────────────────────────────────────────────
pg_matched=$(echo "$staged" | grep -E "^(db/schema_v[0-9]+.*\.sql|deploy/postgres_preamble\.sql|deploy/baseline_grants\.sql|db/baseline/schema[^/]*\.sql|db/baseline/seed_curator_data\.sql)$" || true)
if [[ -n "$pg_matched" ]]; then
    echo "[pre-commit] Postgres source changed — rebuilding golden"
    echo "$pg_matched" | sed 's/^/  · /'
    if ! bash "$REPO/scripts/build_pg_baseline.sh" > /tmp/pg-rebuild.log 2>&1; then
        echo "[pre-commit] ✗ Postgres golden rebuild FAILED (log at /tmp/pg-rebuild.log)"
        tail -20 /tmp/pg-rebuild.log
        echo
        echo "  fix the failure and retry, or bypass with:"
        echo "    SKIP_GOLDEN_REBUILD=1 git commit ..."
        exit 1
    fi
    git add \
        "$REPO/db/baseline/schema_baseline.sql" \
        "$REPO/db/baseline/schema_sessions_baseline.sql" \
        "$REPO/db/baseline/seed_curator_data.sql"
    echo "[pre-commit] ✓ Postgres golden regenerated and staged"
fi

# ── Neo4j ─────────────────────────────────────────────────────────
neo4j_matched=$(echo "$staged" | grep -E "^(load_neo4j\.py|load_graph_relationships\.py|scripts/seed_27701_requirement_nodes\.py|enrichment/relationships/.*\.py|enrichment/documents/.*\.py|iso_nodes_phase1\.json|gdpr_nodes_phase2\.json|db/baseline/load_neo4j_baseline\.py)$" || true)
if [[ -n "$neo4j_matched" ]]; then
    echo "[pre-commit] Neo4j source changed — rebuilding golden (~2-3 min)"
    echo "$neo4j_matched" | sed 's/^/  · /'
    if ! bash "$REPO/scripts/build_neo4j_baseline.sh" > /tmp/neo4j-rebuild.log 2>&1; then
        echo "[pre-commit] ✗ Neo4j golden rebuild FAILED (log at /tmp/neo4j-rebuild.log)"
        tail -20 /tmp/neo4j-rebuild.log
        echo
        echo "  common causes:"
        echo "    · NEO4J_PASSWORD not set — export it or add to .env"
        echo "    · Neo4j service not running — sudo systemctl start neo4j"
        echo "    · dev-host graph missing changes you're committing — apply them first"
        exit 1
    fi
    git add "$REPO/db/baseline/neo4j_baseline.json"
    echo "[pre-commit] ✓ Neo4j golden regenerated and staged"
fi

# ── Chroma (warn only) ────────────────────────────────────────────
chroma_matched=$(echo "$staged" | grep -E "^(scripts/index_.*\.py|scripts/reindex_all\.py|scripts/build_must_index\.py|rag/embedding_config\.py|db/baseline/neo4j_baseline\.json)$" || true)
if [[ -n "$chroma_matched" ]]; then
    echo "[pre-commit] warning: Chroma-affecting file changed"
    echo "$chroma_matched" | sed 's/^/  · /'
    echo "  Chroma golden NOT auto-rebuilt (OpenAI cost + requires private/ PDFs)."
    echo "  Run manually before release:  bash scripts/build_chroma_baseline.sh"
fi

# ── Ship 121'.c — blanket-grant guard ─────────────────────────────
#
# Ship 120' found that `deploy/baseline_grants.sql` had a blanket
# `GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA
# public TO arioncomply_app` that silently clobbered every per-table
# REVOKE from schema_v21 / v79 / v115 / v116. The fix was one
# post-blanket DO block in baseline_grants.sql. This guard prevents
# a NEW blanket grant from re-opening the same drift — a fresh
# install script, ops helper, or migration that grants ALL PRIVILEGES
# on ALL TABLES to arioncomply_app would silently regress the fix.
#
# The one legitimate blanket grant (in `deploy/baseline_grants.sql`)
# is exempted by name.
blanket_grant_matches=$(git diff --cached --name-only --diff-filter=ACMR -- \
    '*.sql' 'deploy/' 'scripts/' 2>/dev/null | while read -r f; do
    [[ -z "$f" || ! -f "$f" ]] && continue
    # Only flag the specific dangerous shape: DELETE (or ALL) on ALL TABLES to arioncomply_app.
    # Whitelist the one intended site.
    if [[ "$f" == "deploy/baseline_grants.sql" ]]; then continue; fi
    if grep -nE 'GRANT[^;]*(\bDELETE\b|\bALL PRIVILEGES\b|\bALL\b)[^;]*ON ALL TABLES[^;]*TO[^;]*arioncomply_app' "$f" > /dev/null 2>&1; then
        grep -nE 'GRANT[^;]*(\bDELETE\b|\bALL PRIVILEGES\b|\bALL\b)[^;]*ON ALL TABLES[^;]*TO[^;]*arioncomply_app' "$f" | sed "s|^|  $f:|"
    fi
done)
if [[ -n "$blanket_grant_matches" ]]; then
    echo "[pre-commit] ✗ blanket GRANT ... ON ALL TABLES ... TO arioncomply_app detected"
    echo "$blanket_grant_matches"
    echo
    echo "  This shape silently clobbers the per-table REVOKEs in the compliance"
    echo "  audit-log discipline (Ship 120'). Enumerate per table instead, or add"
    echo "  a post-blanket REVOKE block that restores intended shape."
    echo "  Bypass with SKIP_GOLDEN_REBUILD=1 or --no-verify only if the shape is"
    echo "  intentional AND baseline_grants.sql restores the affected audit tables."
    exit 1
fi

# ── Ship 121'.d — schema_v* over-grant guard ──────────────────────
#
# Mirror of 121'.c: catches a migration file that CREATES a new
# audit-shape table and grants too much (UPDATE or DELETE) on it in
# the same file. Uses a heuristic — tables whose name ends in `_log`
# or `_audit` — because they're the ones compliance-load-bearing by
# convention.
#
# Escape hatch: put `-- APPEND-ONLY-EXEMPT` on the same line as the
# GRANT if the table is deliberately not append-only.
schema_over_grants=$(git diff --cached --name-only --diff-filter=ACMR -- \
    'db/schema_v*.sql' 2>/dev/null | while read -r f; do
    [[ -z "$f" || ! -f "$f" ]] && continue
    grep -nE 'GRANT[^;]*(\bUPDATE\b|\bDELETE\b|\bALL\b)[^;]*ON[[:space:]]+[a-zA-Z_.]*(_log|_audit)[[:space:]]+TO[[:space:]]+arioncomply_app' "$f" 2>/dev/null | \
        grep -v 'APPEND-ONLY-EXEMPT' | \
        sed "s|^|  $f:|"
done)
if [[ -n "$schema_over_grants" ]]; then
    echo "[pre-commit] ✗ audit-shape table granted UPDATE/DELETE to arioncomply_app"
    echo "$schema_over_grants"
    echo
    echo "  Tables named *_log or *_audit are compliance-load-bearing by convention."
    echo "  Options:"
    echo "    · Change the GRANT to (SELECT, INSERT) only + register the table in"
    echo "      tests/test_audit_table_grants.py APPEND_ONLY_AUDIT_TABLES + add a"
    echo "      matching REVOKE line to deploy/baseline_grants.sql."
    echo "    · If the table is legitimately not append-only, add"
    echo "      '-- APPEND-ONLY-EXEMPT' comment on the same line as the GRANT."
    exit 1
fi

exit 0
