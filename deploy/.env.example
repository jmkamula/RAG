# ArionComply environment — copy to /data/arioncomply/.env on install
# and fill in the values marked CHANGE_ME.

# ── Postgres ─────────────────────────────────────────────────────────
# Two databases: compliance data + LangGraph session checkpointer.
# The API pool uses the arioncomply_app RLS-scoped role. Migrations
# and admin tooling can use the arioncomply owner role.
DATABASE_URL=postgresql://arioncomply_app:CHANGE_ME@127.0.0.1/arioncomply_compliance
SESSIONS_DATABASE_URL=postgresql://arioncomply_app:CHANGE_ME@127.0.0.1/arioncomply_sessions

# Some scripts read individual variables instead of the URL. Keep
# these in sync with DATABASE_URL — they're read by admin tools.
PGHOST=127.0.0.1
PGDATABASE=arioncomply_compliance
PGUSER=arioncomply_app
PGPASSWORD=CHANGE_ME

# ── Neo4j (requirement graph) ────────────────────────────────────────
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME

# ── Chroma (vector store) ────────────────────────────────────────────
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000

# ── LLM providers ────────────────────────────────────────────────────
# OpenAI is the default. Anthropic Claude also supported via
# rag/llm_client.py — leave ANTHROPIC_API_KEY empty if unused.
# For self-hosted models (Ollama, vLLM), point LOCAL_LLM_BASE_URL at
# the OpenAI-compatible endpoint.
OPENAI_API_KEY=CHANGE_ME
LLM_ENDPOINT_OPENAI=https://api.openai.com/v1
ANTHROPIC_API_KEY=
LLM_ENDPOINT_ANTHROPIC=https://api.anthropic.com
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=

# ── API server ───────────────────────────────────────────────────────
API_PORT=8080
CORS_ORIGINS=http://localhost:8080
MAX_UPLOAD_MB=25
DEPLOYMENT_ENV=arion-poc

# ── Feature flags ────────────────────────────────────────────────────
# Ship 33+ extraction consensus. Default OFF; enable per-tenant after
# validating quality on their document corpus.
USE_CONSENSUS_EXTRACTION=0

# ── Observability (OpenTelemetry) ────────────────────────────────────
# Set OTEL_ENABLED=1 to send traces to Jaeger + Phoenix. Requires
# arioncomply-jaeger + arioncomply-phoenix systemd services.
# Privacy tier: off | observability | debug
#   off           — no tracing
#   observability — paths + latencies + counts (safe for prod)
#   debug         — + prompt/completion content (INTERNAL ONLY)
OTEL_ENABLED=0
OTEL_PRIVACY_LEVEL=observability
OTEL_SERVICE_NAME=arioncomply-api
OTEL_JAEGER_ENDPOINT=http://127.0.0.1:4317
OTEL_PHOENIX_ENDPOINT=http://127.0.0.1:6317
