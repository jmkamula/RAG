# ArionComply sweep scheduler — systemd oneshot (Wave 3b, 2026-07-13)
#
# One-shot invocation of the sweep tick. Paired with
# arioncomply-scheduler.timer for periodic firing.
#
# Install:
#     sudo cp deploy/arioncomply-scheduler.service /etc/systemd/system/
#     sudo cp deploy/arioncomply-scheduler.timer   /etc/systemd/system/
#     sudo systemctl daemon-reload
#     sudo systemctl enable --now arioncomply-scheduler.timer
#
# Check status:
#     systemctl list-timers | grep arioncomply
#     journalctl -u arioncomply-scheduler.service --since '-1h'

[Unit]
Description=ArionComply sweep tick (fact recompute + followups + freshness)
After=network.target postgresql.service

[Service]
Type=oneshot
User=arionlabs
Group=arionlabs
WorkingDirectory=/data/arioncomply
Environment=PYTHONPATH=/data/arioncomply
EnvironmentFile=/data/arioncomply/.env
ExecStart=/usr/bin/python3 -m rag.scheduler.tick --json
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
