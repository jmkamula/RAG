[Unit]
Description=ArionComply Jaeger tracing backend (all-in-one)
Documentation=https://github.com/jmkamula/RAG/blob/main/docs/memory/ship_44_prime_a_otel_jaeger_design_2026_07_26.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=arionlabs
Group=arionlabs
ExecStart=/opt/jaeger/jaeger-all-in-one \
    --collector.otlp.enabled=true \
    --collector.otlp.grpc.host-port=127.0.0.1:4317 \
    --collector.otlp.http.host-port=127.0.0.1:4318 \
    --query.http-server.host-port=127.0.0.1:16686 \
    --query.grpc-server.host-port=127.0.0.1:16685 \
    --admin.http.host-port=127.0.0.1:14269 \
    --collector.grpc-server.host-port=127.0.0.1:14250 \
    --collector.http-server.host-port=127.0.0.1:14268
Restart=on-failure
RestartSec=5s

# Bind 127.0.0.1 only — traces contain tenant queries, evidence text,
# LLM prompt fragments. Never expose externally without redaction.

# In-memory storage (default) — traces disappear on restart. Sufficient
# for demo tenant load; badger persistence is a later arc.

StandardOutput=append:/tmp/arioncomply-jaeger.log
StandardError=inherit
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
